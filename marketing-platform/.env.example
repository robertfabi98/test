# Copia questo file in .env e completa i valori.  NON caricare mai il file .env su GitHub.

# Cartella dei contenuti sull'hard disk esterno.
# Nel Finder: tasto destro sulla cartella, tieni premuto Option, "Copia ... come nome percorso"
MEDIA_DIR=/Volumes/NomeDisco/Contenuti

# Claude: crea la chiave su https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
MODELLO_CLAUDE=claude-opus-5-5
# low | medium | high: più alto = ragionamento più accurato, costo maggiore
EFFORT_CLAUDE=medium

# Buffer: crea la chiave su https://publish.buffer.com/settings/api
BUFFER_API_KEY=
BUFFER_ORG_ID=6ad06d28221b43577939e3bd
# Categoria YouTube: 22 = Persone e blog, 27 = Istruzione
YOUTUBE_CATEGORY_ID=22

# Cloudinary: Dashboard > API Keys > "API environment variable"
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=marketing-platform

# 1 = modalità prova: non invia niente a Buffer (consigliato per i primi test)
# 0 = pubblica davvero
DRY_RUN=1

# Trascrizione: tiny | base | small | medium | large-v3 (più grande = più preciso e più lento)
WHISPER_MODEL=small
WHISPER_LANGUAGE=it

TIMEZONE=Europe/Rome
PORT=8765
